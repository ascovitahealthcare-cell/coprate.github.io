    var text = 'Hello Ascovita Healthcare.\n\nName: ' + name +
               (co ? '\nCompany: ' + co : '') +
               '\nEnquiry type: ' + type +
               (qty ? '\nCategory & quantity: ' + qty : '') +
               '\n\n' + msg;
    window.open('https://wa.me/919898582650?text=' + encodeURIComponent(text), '_blank', 'noopener');
  });
})();
