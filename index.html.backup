<style>
/* ══════════════════════════════════════════════════════════════════
   ASCOVITA HEALTHCARE — shared stylesheet
   Soft neumorphism · minimal · colour taken from the logo

   Contrast note: neumorphism normally fails accessibility because
   people put low-contrast text on low-contrast surfaces. Here the
   soft treatment is applied ONLY to surfaces and controls. All text
   stays dark ink on a light ground, so every reading size clears
   WCAG AA.
   ══════════════════════════════════════════════════════════════════ */

:root{
  /* ground */
  --bg:#E8EDE6;
  --bg-2:#EDF1EB;
  --white:#FFFFFF;

  /* neumorphic shadow pair — one warm light, one cool shade */
  --hi:rgba(255,255,255,.92);
  --lo:rgba(150,166,148,.52);

  --nm:10px 10px 24px var(--lo), -10px -10px 24px var(--hi);
  --nm-sm:5px 5px 13px var(--lo), -5px -5px 13px var(--hi);
  --nm-xs:3px 3px 7px var(--lo), -3px -3px 7px var(--hi);
  --nm-in:inset 6px 6px 14px var(--lo), inset -6px -6px 14px var(--hi);
  --nm-in-sm:inset 3px 3px 8px var(--lo), inset -3px -3px 8px var(--hi);

  /* ink */
  --ink:#17211A;
  --ink-2:#4B5950;
  --ink-3:#87938B;
  --line:rgba(23,33,26,.09);

  /* logo colour, used sparingly */
  --green:#2E7D32;
  --green-d:#1C5620;
  --green-l:#8CC48F;
  --gold:#C9A227;

  --font:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;

  --gut:clamp(20px,4.4vw,56px);
  --max:1240px;
  --r:22px;
  --r-sm:14px;
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{
  background:var(--bg);color:var(--ink);
  font-family:var(--font);font-size:17px;line-height:1.55;
  font-feature-settings:'cv02','cv03','cv04','cv11';
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
:focus-visible{outline:2.5px solid var(--green);outline-offset:4px;border-radius:6px}
::selection{background:var(--green);color:#fff}

@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}

.wrap{max-width:var(--max);margin-inline:auto;padding-inline:var(--gut)}
.narrow{max-width:920px;margin-inline:auto}

/* ── type scale ─────────────────────────────────────────────────── */
.t-hero{font-size:clamp(40px,7.4vw,88px);line-height:1.03;letter-spacing:-.038em;font-weight:700}
.t-1{font-size:clamp(32px,5vw,60px);line-height:1.06;letter-spacing:-.032em;font-weight:700}
.t-2{font-size:clamp(24px,3.2vw,38px);line-height:1.14;letter-spacing:-.026em;font-weight:700}
.t-3{font-size:clamp(19px,1.9vw,23px);line-height:1.3;letter-spacing:-.018em;font-weight:600}
.lede{font-size:clamp(17px,1.75vw,21px);line-height:1.55;color:var(--ink-2);font-weight:400}
.sm{font-size:15px;line-height:1.6;color:var(--ink-2)}
.xs{font-size:13px;line-height:1.55;color:var(--ink-3)}
.eyebrow{font-size:12px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:var(--green)}
.grad{background:linear-gradient(103deg,var(--green-d),var(--green) 46%,var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent}
.center{text-align:center}

/* ── nav ────────────────────────────────────────────────────────── */
.nav{position:sticky;top:0;z-index:60;padding-top:12px;padding-bottom:12px;
     background:linear-gradient(var(--bg) 62%,rgba(232,237,230,0));}
.nav-in{
  display:flex;align-items:center;gap:20px;height:58px;padding-inline:18px;
  background:var(--bg);border-radius:100px;box-shadow:var(--nm-sm);
}
.brand{display:flex;align-items:center;gap:10px;margin-right:auto}
.brand img{height:26px;width:auto}
.brand .fallback{font-weight:700;font-size:18px;letter-spacing:-.02em}
.nav-links{display:flex;gap:2px}
.nav-links a{
  font-size:13.5px;font-weight:500;color:var(--ink-2);
  padding:8px 15px;border-radius:100px;transition:color .2s,box-shadow .2s;
}
.nav-links a:hover{color:var(--ink)}
.nav-links a[aria-current="page"]{color:var(--ink);box-shadow:var(--nm-in-sm)}
.nav-toggle{display:none;width:40px;height:40px;border-radius:50%;box-shadow:var(--nm-xs);
            align-items:center;justify-content:center}
.nav-toggle span{display:block;width:16px;height:1.5px;background:var(--ink);position:relative}
.nav-toggle span::before,.nav-toggle span::after{content:"";position:absolute;left:0;width:16px;height:1.5px;background:var(--ink)}
.nav-toggle span::before{top:-5px}.nav-toggle span::after{top:5px}
@media (max-width:940px){
  .nav-links{
    display:none;position:absolute;top:78px;left:var(--gut);right:var(--gut);
    flex-direction:column;gap:4px;padding:14px;border-radius:var(--r);
    background:var(--bg);box-shadow:var(--nm);
  }
  .nav-links.open{display:flex}
  .nav-links a{padding:12px 16px}
  .nav-toggle{display:flex}
  .nav .btn{display:none}
}

/* ── buttons ────────────────────────────────────────────────────── */
.btn{
  display:inline-flex;align-items:center;gap:8px;
  font-size:14.5px;font-weight:600;letter-spacing:-.01em;
  padding:13px 24px;border-radius:100px;
  background:var(--green);color:#fff;
  box-shadow:0 8px 20px -8px rgba(46,125,50,.7);
  transition:transform .28s cubic-bezier(.2,.8,.3,1),box-shadow .28s;
}
.btn:hover{transform:translateY(-2px);box-shadow:0 14px 28px -10px rgba(46,125,50,.8)}
.btn:active{transform:translateY(0)}
.btn.soft{background:var(--bg);color:var(--ink);box-shadow:var(--nm-sm)}
.btn.soft:hover{box-shadow:var(--nm)}
.btn.soft:active{box-shadow:var(--nm-in-sm)}
.btn.small{padding:10px 18px;font-size:13.5px}
.btn i{font-style:normal;transition:transform .28s}
.btn:hover i{transform:translateX(3px)}

/* ── layout blocks ──────────────────────────────────────────────── */
section{padding-block:clamp(64px,9vw,124px)}
.tight{padding-block:clamp(40px,6vw,72px)}

.card{background:var(--bg);border-radius:var(--r);padding:clamp(24px,3.2vw,40px);box-shadow:var(--nm)}
.card.flat{box-shadow:var(--nm-sm)}
.card.sunk{box-shadow:var(--nm-in)}

.grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(16px,2.4vw,28px)}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(16px,2.4vw,28px)}
.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(14px,2vw,24px)}
@media (max-width:980px){.grid-3,.grid-4{grid-template-columns:repeat(2,1fr)}}
@media (max-width:660px){.grid-2,.grid-3,.grid-4{grid-template-columns:1fr}}

.split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,4vw,64px);align-items:center}
@media (max-width:900px){.split{grid-template-columns:1fr;gap:28px}}

/* ── page hero ──────────────────────────────────────────────────── */
.phero{position:relative;padding-top:clamp(48px,8vw,92px);padding-bottom:clamp(40px,6vw,72px)}
.phero .t-hero{max-width:17ch}
.phero .lede{max-width:56ch;margin-top:20px}
.phero .actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}

/* ── fluid canvas ───────────────────────────────────────────────── */
.fluid-shell{
  position:relative;border-radius:clamp(24px,3.4vw,40px);overflow:hidden;
  box-shadow:var(--nm-in);background:var(--bg-2);
  aspect-ratio:16/10;
}
@media (max-width:700px){.fluid-shell{aspect-ratio:4/5}}
.fluid-shell canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.fluid-shell .veil{
  position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(72% 62% at 50% 50%, rgba(232,237,230,0) 40%, rgba(232,237,230,.72) 100%);
}
.fluid-shell .note{
  position:absolute;left:18px;bottom:16px;z-index:2;
  font-size:11.5px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;
  color:var(--ink-3);pointer-events:none;
}
.fluid-shell.fallback{background:
  radial-gradient(58% 54% at 34% 36%, rgba(140,196,143,.55), transparent 62%),
  radial-gradient(50% 48% at 68% 62%, rgba(201,162,39,.32), transparent 60%),
  var(--bg-2);}

/* ── logo lockup on soft disc ───────────────────────────────────── */
.disc{
  width:clamp(88px,11vw,128px);aspect-ratio:1;border-radius:50%;
  background:var(--bg);box-shadow:var(--nm);
  display:grid;place-items:center;padding:18%;
}
.disc img{width:100%;height:auto}

/* ── stat ───────────────────────────────────────────────────────── */
.stat b{display:block;font-size:clamp(30px,3.8vw,46px);font-weight:700;letter-spacing:-.035em;line-height:1}
.stat b u{text-decoration:none;font-size:.46em;font-weight:600;margin-left:2px;color:var(--ink-3)}
.stat span{display:block;font-size:12.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-3);margin-top:10px}

/* ── division card ──────────────────────────────────────────────── */
.dvc{display:flex;flex-direction:column;height:100%}
.dvc .chip{
  display:inline-flex;align-self:flex-start;align-items:center;gap:7px;
  font-size:11.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
  padding:7px 13px;border-radius:100px;box-shadow:var(--nm-in-sm);color:var(--ink-2);
}
.dvc .chip::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--dot,var(--green))}
.dvc h3{margin:18px 0 6px}
.dvc .where{font-size:13px;font-weight:600;letter-spacing:.06em;color:var(--ink-3);text-transform:uppercase}
.dvc p{margin-top:14px}
.dvc ul{list-style:none;margin-top:18px;display:grid;gap:9px}
.dvc li{font-size:14.5px;color:var(--ink-2);padding-left:20px;position:relative}
.dvc li::before{content:"";position:absolute;left:0;top:.56em;width:9px;height:9px;border-radius:50%;box-shadow:var(--nm-in-sm)}
.dvc .foot{margin-top:auto;padding-top:26px}

/* ── list rows ──────────────────────────────────────────────────── */
.rows{display:grid;gap:12px}
.row{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.5fr);gap:clamp(14px,3vw,44px);
     padding:clamp(20px,2.6vw,30px);border-radius:var(--r-sm);box-shadow:var(--nm-sm);
     transition:box-shadow .3s,transform .3s}
.row:hover{box-shadow:var(--nm);transform:translateY(-2px)}
@media (max-width:760px){.row{grid-template-columns:1fr;gap:8px}}

/* ── marquee of formats ─────────────────────────────────────────── */
.pills{display:flex;flex-wrap:wrap;gap:10px}
.pills span{font-size:13.5px;font-weight:500;color:var(--ink-2);padding:10px 18px;border-radius:100px;box-shadow:var(--nm-xs)}

/* ── contact ────────────────────────────────────────────────────── */
.field{display:block;margin-bottom:16px}
.field span{display:block;font-size:12.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);margin-bottom:9px}
.field input,.field select,.field textarea{
  width:100%;font:inherit;font-size:16px;color:var(--ink);
  background:var(--bg);border:0;border-radius:var(--r-sm);
  padding:15px 18px;box-shadow:var(--nm-in-sm);
}
.field textarea{min-height:130px;resize:vertical}
.field input::placeholder,.field textarea::placeholder{color:var(--ink-3)}

/* ── footer ─────────────────────────────────────────────────────── */
footer{padding-block:clamp(48px,6vw,72px) 40px}
.fcard{border-radius:clamp(24px,3vw,34px);padding:clamp(28px,4vw,52px);box-shadow:var(--nm)}
.fgrid{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:clamp(22px,3vw,40px)}
@media (max-width:860px){.fgrid{grid-template-columns:1fr 1fr}}
@media (max-width:520px){.fgrid{grid-template-columns:1fr}}
.fcol h4{font-size:12px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-3);margin-bottom:14px}
.fcol a{display:block;font-size:14.5px;color:var(--ink-2);padding-block:5px;transition:color .2s}
.fcol a:hover{color:var(--green)}
.fine{margin-top:34px;padding-top:22px;border-top:1px solid var(--line);font-size:12.5px;line-height:1.7;color:var(--ink-3)}

/* ── reveal ─────────────────────────────────────────────────────── */
.rv{opacity:0;transform:translateY(20px);transition:opacity .85s cubic-bezier(.16,.84,.3,1),transform .85s cubic-bezier(.16,.84,.3,1)}
.rv.in{opacity:1;transform:none}
.rv.s1{transition-delay:.07s}.rv.s2{transition-delay:.14s}.rv.s3{transition-delay:.21s}
@media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none}}

/* ── FAQ accordion ──────────────────────────────────────────────
   Native details/summary rather than JS: keyboard accessible and
   findable by the browser's in-page search even while collapsed. */
details.row{display:block;cursor:pointer}
details.row summary{
  display:flex;align-items:center;justify-content:space-between;gap:18px;
  list-style:none;cursor:pointer;
}
details.row summary::-webkit-details-marker{display:none}
details.row summary::after{
  content:"";flex:0 0 26px;height:26px;border-radius:50%;box-shadow:var(--nm-xs);
  background:
    linear-gradient(var(--ink),var(--ink)) center/9px 1.5px no-repeat,
    linear-gradient(var(--ink),var(--ink)) center/1.5px 9px no-repeat;
  transition:transform .3s cubic-bezier(.2,.8,.3,1);
}
details.row[open] summary::after{transform:rotate(135deg);box-shadow:var(--nm-in-sm)}
details.row summary h3{margin:0}
details.row > p{margin-top:16px;max-width:74ch;animation:faqIn .32s ease both}
@keyframes faqIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){details.row > p{animation:none}}

/* blockquote cards carry no default indent */
blockquote{margin:0}

/* ══════════════════════════════════════════════════════════════════
   UI LAYER 2 — imagery, motion surfaces, marquee
   ══════════════════════════════════════════════════════════════════ */

/* ── scroll progress rail ───────────────────────────────────────── */
#progress{
  position:fixed;top:0;left:0;right:0;height:2px;z-index:80;
  background:linear-gradient(90deg,var(--green-d),var(--green) 55%,var(--gold));
  transform:scaleX(0);transform-origin:left;will-change:transform;
}

/* ── raymarched art panel ───────────────────────────────────────── */
.art-shell{
  position:relative;border-radius:clamp(24px,3.4vw,40px);overflow:hidden;
  box-shadow:var(--nm-in);background:var(--bg-2);aspect-ratio:16/9;
}
@media (max-width:700px){.art-shell{aspect-ratio:1/1}}
.art-shell canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.art-shell.fallback{background:
  radial-gradient(46% 52% at 50% 44%, rgba(255,255,255,.95), transparent 66%),
  radial-gradient(40% 40% at 62% 64%, rgba(201,162,39,.26), transparent 62%),
  var(--bg-2);}
.art-cap{
  position:absolute;left:22px;bottom:18px;z-index:2;pointer-events:none;
  font-size:11.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);
}

/* ── tilt surfaces ──────────────────────────────────────────────── */
[data-tilt]{transition:transform .5s cubic-bezier(.2,.8,.3,1),box-shadow .35s;transform-style:preserve-3d;will-change:transform}
[data-tilt]:hover{box-shadow:14px 14px 34px var(--lo), -14px -14px 34px var(--hi)}
[data-magnetic]{transition:transform .35s cubic-bezier(.2,.8,.3,1)}

/* ── product / image cards ──────────────────────────────────────── */
.pcard{display:flex;flex-direction:column;overflow:hidden}
.pcard .shot{
  border-radius:var(--r-sm);overflow:hidden;box-shadow:var(--nm-in-sm);
  background:var(--bg-2);aspect-ratio:1;display:grid;place-items:center;padding:10%;
}
.pcard .shot img{width:100%;height:100%;object-fit:contain;
  transition:transform .55s cubic-bezier(.2,.8,.3,1);mix-blend-mode:multiply}
.pcard:hover .shot img{transform:scale(1.06)}
.pcard h3{margin-top:18px}
.pcard .meta{font-size:12.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);margin-top:8px}

/* ── marquee ────────────────────────────────────────────────────── */
.mq{overflow:hidden;position:relative;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent);
            mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent)}
.mq-track{display:flex;gap:clamp(14px,2vw,24px);width:max-content}
.mq-run .mq-track{animation:mq linear infinite}
.mq:hover .mq-track{animation-play-state:paused}
@keyframes mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.mq-static .mq-track{flex-wrap:wrap;width:auto;justify-content:center}
.mq-item{
  flex:0 0 auto;width:clamp(148px,20vw,210px);
  border-radius:var(--r-sm);box-shadow:var(--nm-sm);background:var(--bg);
  padding:14px;
}
.mq-item .shot{border-radius:10px;overflow:hidden;box-shadow:var(--nm-in-sm);
  background:var(--bg-2);aspect-ratio:1;display:grid;place-items:center;padding:9%}
.mq-item img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}
.mq-item p{font-size:12.5px;line-height:1.4;margin-top:11px;color:var(--ink-2);font-weight:500}

/* ── numbered process rail ──────────────────────────────────────── */
.steps{counter-reset:step;display:grid;gap:12px}
.stepc{position:relative;padding-left:clamp(58px,7vw,84px)}
.stepc::before{
  counter-increment:step;content:counter(step,decimal-leading-zero);
  position:absolute;left:0;top:0;
  width:clamp(42px,5.4vw,58px);aspect-ratio:1;border-radius:50%;
  display:grid;place-items:center;box-shadow:var(--nm-sm);
  font-size:13px;font-weight:700;letter-spacing:-.02em;color:var(--green);
}

/* ── brochure / download card ───────────────────────────────────── */
.dl{display:flex;flex-direction:column;height:100%}
.dl .tagline{font-size:11.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--gold)}
.dl h3{margin-top:12px}
.dl p{margin-top:12px}
.dl .foot{margin-top:auto;padding-top:22px;display:flex;gap:10px;flex-wrap:wrap}

/* ── certification badges ───────────────────────────────────────── */
.badges{display:grid;grid-template-columns:repeat(auto-fit,minmax(148px,1fr));gap:clamp(12px,2vw,20px)}
.badge{border-radius:var(--r-sm);box-shadow:var(--nm-sm);padding:20px 18px;text-align:center}
.badge b{display:block;font-size:15px;font-weight:700;letter-spacing:-.01em}
.badge span{display:block;font-size:12px;color:var(--ink-3);margin-top:6px}

/* ── split feature with image ───────────────────────────────────── */
.figure{border-radius:var(--r);overflow:hidden;box-shadow:var(--nm-in);background:var(--bg-2);
        aspect-ratio:4/3;display:grid;place-items:center;padding:8%}
.figure img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}

/* ── table ──────────────────────────────────────────────────────── */
.tbl{width:100%;border-collapse:collapse;font-size:14.5px}
.tbl th,.tbl td{text-align:left;padding:14px 16px;border-bottom:1px solid var(--line)}
.tbl th{font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3)}
.tbl tr:last-child td{border-bottom:0}
.tbl td strong{font-weight:600}
.tbl-wrap{overflow-x:auto;border-radius:var(--r-sm);box-shadow:var(--nm-in-sm);padding:6px 4px}

/* ── skip link ──────────────────────────────────────────────────── */
.skip{
  position:absolute;left:-9999px;top:0;z-index:100;
  background:var(--ink);color:var(--bg);padding:12px 20px;border-radius:0 0 12px 0;
  font-size:14px;font-weight:600;
}
.skip:focus{left:0}


/* ── SPA pages ──────────────────────────────────────────────────── */
.page[hidden]{display:none}
.page{animation:pageIn .42s cubic-bezier(.16,.84,.3,1) both}
@keyframes pageIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.page{animation:none}}

</style>
</head>
