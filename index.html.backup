<script>
/* ══════════════════════════════════════════════════════════════════
   fluid.js — Ascovita Healthcare

   A real-time incompressible fluid solver on the GPU (stable fluids:
   advect → curl → vorticity → divergence → pressure → project).
   Not a looping video, not a noise texture — the dye actually obeys
   the velocity field, so it swirls differently every time and reacts
   to the pointer.

   Dye is restricted to a narrow band around the Ascovita green with
   an occasional gold, so it reads as one liquid rather than a rainbow.

   initFluid(canvasEl) → { destroy() }  ·  returns null if WebGL is
   unavailable, so the caller can fall back to a static gradient.
   ══════════════════════════════════════════════════════════════════ */

function initFluid(canvas){
  var CFG = {
    SIM:128, DYE:512,
    DENSITY_DISSIPATION:0.965,
    VELOCITY_DISSIPATION:0.985,
    PRESSURE:0.78, PRESSURE_ITER:18,
    CURL:26, RADIUS:0.19
  };

  var params = { alpha:false, depth:false, stencil:false, antialias:false, preserveDrawingBuffer:false };
  var gl = canvas.getContext('webgl2', params);
  var isWebGL2 = !!gl;
  if (!gl) gl = canvas.getContext('webgl', params) || canvas.getContext('experimental-webgl', params);
  if (!gl) return null;

  var halfFloat, supportLinear;
  if (isWebGL2) {
    gl.getExtension('EXT_color_buffer_float');
    supportLinear = !!gl.getExtension('OES_texture_float_linear');
  } else {
    halfFloat = gl.getExtension('OES_texture_half_float');
    supportLinear = !!gl.getExtension('OES_texture_half_float_linear');
    if (!halfFloat) return null;
  }
  var HALF = isWebGL2 ? gl.HALF_FLOAT : halfFloat.HALF_FLOAT_OES;

  function fmt(internal, format, type){
    if (!supported(internal, format, type)) {
      if (!isWebGL2) return null;
      if (internal === gl.R16F)    return fmt(gl.RG16F,   gl.RG,   type);
      if (internal === gl.RG16F)   return fmt(gl.RGBA16F, gl.RGBA, type);
      return null;
    }
    return { internalFormat:internal, format:format };
  }
  function supported(internal, format, type){
    var tex = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.texImage2D(gl.TEXTURE_2D, 0, internal, 4, 4, 0, format, type, null);
    var fbo = gl.createFramebuffer();
    gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
    gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, tex, 0);
    var ok = gl.checkFramebufferStatus(gl.FRAMEBUFFER) === gl.FRAMEBUFFER_COMPLETE;
    gl.deleteFramebuffer(fbo); gl.deleteTexture(tex);
    gl.bindFramebuffer(gl.FRAMEBUFFER, null);
    return ok;
  }

  var RGBA = isWebGL2 ? fmt(gl.RGBA16F, gl.RGBA, HALF) : fmt(gl.RGBA, gl.RGBA, HALF);
  var RG   = isWebGL2 ? fmt(gl.RG16F,   gl.RG,   HALF) : fmt(gl.RGBA, gl.RGBA, HALF);
  var R    = isWebGL2 ? fmt(gl.R16F,    gl.RED,  HALF) : fmt(gl.RGBA, gl.RGBA, HALF);
  if (!RGBA || !RG || !R) return null;
  var FILTER = supportLinear ? gl.LINEAR : gl.NEAREST;

  /* ── shader plumbing ─────────────────────────────────────────── */
  function compile(type, src){
    var s = gl.createShader(type);
    gl.shaderSource(s, src); gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) { console.warn(gl.getShaderInfoLog(s)); return null; }
    return s;
  }
  function Program(vs, fs){
    var p = gl.createProgram();
    gl.attachShader(p, vs); gl.attachShader(p, fs); gl.linkProgram(p);
    this.program = p; this.uniforms = {};
    var n = gl.getProgramParameter(p, gl.ACTIVE_UNIFORMS);
    for (var i=0;i<n;i++){ var name = gl.getActiveUniform(p, i).name; this.uniforms[name] = gl.getUniformLocation(p, name); }
  }
  Program.prototype.bind = function(){ gl.useProgram(this.program); };

  var baseVS = compile(gl.VERTEX_SHADER, [
    'precision highp float;',
    'attribute vec2 aPosition;',
    'varying vec2 vUv, vL, vR, vT, vB;',
    'uniform vec2 texelSize;',
    'void main(){',
    ' vUv = aPosition * 0.5 + 0.5;',
    ' vL = vUv - vec2(texelSize.x, 0.0);',
    ' vR = vUv + vec2(texelSize.x, 0.0);',
    ' vT = vUv + vec2(0.0, texelSize.y);',
    ' vB = vUv - vec2(0.0, texelSize.y);',
    ' gl_Position = vec4(aPosition, 0.0, 1.0);',
    '}'].join('\n'));

  function F(src){ return compile(gl.FRAGMENT_SHADER, 'precision highp float;precision highp sampler2D;\n' + src); }

  var copyFS = F([
    'varying vec2 vUv; uniform sampler2D uTexture;',
    'void main(){ gl_FragColor = texture2D(uTexture, vUv); }'].join('\n'));

  var displayFS = F([
    'varying vec2 vUv; uniform sampler2D uTexture;',
    'void main(){',
    ' vec3 c = texture2D(uTexture, vUv).rgb;',
    // The dye is an absorption field, not an emissive one: it is subtracted
    // from the page ground so the liquid always sits in the same soft
    // neumorphic range as the rest of the site and can never go black.
    ' vec3 ground = vec3(0.910, 0.929, 0.902);',
    ' gl_FragColor = vec4(clamp(ground - c * 0.85, 0.0, 1.0), 1.0);',
    '}'].join('\n'));

  var splatFS = F([
    'varying vec2 vUv; uniform sampler2D uTarget; uniform float aspectRatio;',
    'uniform vec3 color; uniform vec2 point; uniform float radius;',
    'void main(){',
    ' vec2 p = vUv - point.xy; p.x *= aspectRatio;',
    ' vec3 splat = exp(-dot(p,p)/radius) * color;',
    ' gl_FragColor = vec4(texture2D(uTarget, vUv).xyz + splat, 1.0);',
    '}'].join('\n'));

  var advectionFS = F([
    'varying vec2 vUv; uniform sampler2D uVelocity, uSource;',
    'uniform vec2 texelSize, dyeTexelSize; uniform float dt, dissipation;',
    'vec4 bilerp(sampler2D s, vec2 uv, vec2 tsize){',
    ' vec2 st = uv/tsize - 0.5; vec2 iuv = floor(st); vec2 fuv = fract(st);',
    ' vec4 a = texture2D(s,(iuv+vec2(0.5,0.5))*tsize), b = texture2D(s,(iuv+vec2(1.5,0.5))*tsize);',
    ' vec4 c = texture2D(s,(iuv+vec2(0.5,1.5))*tsize), d = texture2D(s,(iuv+vec2(1.5,1.5))*tsize);',
    ' return mix(mix(a,b,fuv.x), mix(c,d,fuv.x), fuv.y);',
    '}',
    'void main(){',
    ' vec2 coord = vUv - dt * bilerp(uVelocity, vUv, texelSize).xy * texelSize;',
    ' gl_FragColor = bilerp(uSource, coord, dyeTexelSize) / (1.0 + dissipation*dt);',
    '}'].join('\n'));

  var divergenceFS = F([
    'varying highp vec2 vUv, vL, vR, vT, vB; uniform sampler2D uVelocity;',
    'void main(){',
    ' float L = texture2D(uVelocity, vL).x, Rr = texture2D(uVelocity, vR).x;',
    ' float T = texture2D(uVelocity, vT).y, B = texture2D(uVelocity, vB).y;',
    ' vec2 C = texture2D(uVelocity, vUv).xy;',
    ' if (vL.x < 0.0) L = -C.x; if (vR.x > 1.0) Rr = -C.x;',
    ' if (vT.y > 1.0) T = -C.y; if (vB.y < 0.0) B = -C.y;',
    ' gl_FragColor = vec4(0.5*(Rr-L+T-B), 0.0, 0.0, 1.0);',
    '}'].join('\n'));

  var curlFS = F([
    'varying highp vec2 vUv, vL, vR, vT, vB; uniform sampler2D uVelocity;',
    'void main(){',
    ' float L = texture2D(uVelocity, vL).y, Rr = texture2D(uVelocity, vR).y;',
    ' float T = texture2D(uVelocity, vT).x, B = texture2D(uVelocity, vB).x;',
    ' gl_FragColor = vec4(Rr - L - T + B, 0.0, 0.0, 1.0);',
    '}'].join('\n'));

  var vorticityFS = F([
    'varying highp vec2 vUv, vL, vR, vT, vB;',
    'uniform sampler2D uVelocity, uCurl; uniform float curl, dt;',
    'void main(){',
    ' float L = texture2D(uCurl, vL).x, Rr = texture2D(uCurl, vR).x;',
    ' float T = texture2D(uCurl, vT).x, B = texture2D(uCurl, vB).x;',
    ' float C = texture2D(uCurl, vUv).x;',
    ' vec2 force = 0.5 * vec2(abs(T)-abs(B), abs(Rr)-abs(L));',
    ' force /= length(force) + 0.0001; force *= curl * C; force.y *= -1.0;',
    ' vec2 vel = texture2D(uVelocity, vUv).xy + force * dt;',
    ' vel = min(max(vel, -1000.0), 1000.0);',
    ' gl_FragColor = vec4(vel, 0.0, 1.0);',
    '}'].join('\n'));

  var pressureFS = F([
    'varying highp vec2 vUv, vL, vR, vT, vB; uniform sampler2D uPressure, uDivergence;',
    'void main(){',
    ' float L = texture2D(uPressure, vL).x, Rr = texture2D(uPressure, vR).x;',
    ' float T = texture2D(uPressure, vT).x, B = texture2D(uPressure, vB).x;',
    ' float div = texture2D(uDivergence, vUv).x;',
    ' gl_FragColor = vec4((L + Rr + B + T - div) * 0.25, 0.0, 0.0, 1.0);',
    '}'].join('\n'));

  var gradientFS = F([
    'varying highp vec2 vUv, vL, vR, vT, vB; uniform sampler2D uPressure, uVelocity;',
    'void main(){',
    ' float L = texture2D(uPressure, vL).x, Rr = texture2D(uPressure, vR).x;',
    ' float T = texture2D(uPressure, vT).x, B = texture2D(uPressure, vB).x;',
    ' vec2 vel = texture2D(uVelocity, vUv).xy - vec2(Rr-L, T-B);',
    ' gl_FragColor = vec4(vel, 0.0, 1.0);',
    '}'].join('\n'));

  var clearFS = F([
    'varying vec2 vUv; uniform sampler2D uTexture; uniform float value;',
    'void main(){ gl_FragColor = value * texture2D(uTexture, vUv); }'].join('\n'));

  if (!baseVS || !copyFS || !displayFS || !splatFS || !advectionFS) return null;

  var copyP = new Program(baseVS, copyFS),
      displayP = new Program(baseVS, displayFS),
      splatP = new Program(baseVS, splatFS),
      advectP = new Program(baseVS, advectionFS),
      divP = new Program(baseVS, divergenceFS),
      curlP = new Program(baseVS, curlFS),
      vortP = new Program(baseVS, vorticityFS),
      pressP = new Program(baseVS, pressureFS),
      gradP = new Program(baseVS, gradientFS),
      clearP = new Program(baseVS, clearFS);

  /* full-screen quad */
  var vbo = gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, -1,1, 1,1, 1,-1]), gl.STATIC_DRAW);
  var ibo = gl.createBuffer();
  gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, ibo);
  gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, new Uint16Array([0,1,2, 0,2,3]), gl.STATIC_DRAW);
  gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
  gl.enableVertexAttribArray(0);

  function blit(target){
    if (target == null){ gl.viewport(0,0,gl.drawingBufferWidth,gl.drawingBufferHeight); gl.bindFramebuffer(gl.FRAMEBUFFER, null); }
    else { gl.viewport(0,0,target.width,target.height); gl.bindFramebuffer(gl.FRAMEBUFFER, target.fbo); }
    gl.drawElements(gl.TRIANGLES, 6, gl.UNSIGNED_SHORT, 0);
  }

  function createFBO(w,h,internal,format,type,filter){
    gl.activeTexture(gl.TEXTURE0);
    var tex = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, filter);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, filter);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.texImage2D(gl.TEXTURE_2D, 0, internal, w, h, 0, format, type, null);
    var fbo = gl.createFramebuffer();
    gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
    gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, tex, 0);
    gl.viewport(0,0,w,h); gl.clear(gl.COLOR_BUFFER_BIT);
    return { texture:tex, fbo:fbo, width:w, height:h, texelSizeX:1/w, texelSizeY:1/h,
      attach:function(id){ gl.activeTexture(gl.TEXTURE0 + id); gl.bindTexture(gl.TEXTURE_2D, tex); return id; } };
  }
  function createDouble(w,h,internal,format,type,filter){
    var a = createFBO(w,h,internal,format,type,filter), b = createFBO(w,h,internal,format,type,filter);
    return { width:w, height:h, texelSizeX:a.texelSizeX, texelSizeY:a.texelSizeY,
      get read(){ return a; }, set read(v){ a = v; },
      get write(){ return b; }, set write(v){ b = v; },
      swap:function(){ var t=a; a=b; b=t; } };
  }

  var dye, velocity, divergence, curlFBO, pressure;
  function initBuffers(){
    var s = res(CFG.SIM), d = res(CFG.DYE);
    dye      = createDouble(d.w, d.h, RGBA.internalFormat, RGBA.format, HALF, FILTER);
    velocity = createDouble(s.w, s.h, RG.internalFormat,  RG.format,  HALF, FILTER);
    divergence = createFBO(s.w, s.h, R.internalFormat, R.format, HALF, gl.NEAREST);
    curlFBO    = createFBO(s.w, s.h, R.internalFormat, R.format, HALF, gl.NEAREST);
    pressure   = createDouble(s.w, s.h, R.internalFormat, R.format, HALF, gl.NEAREST);
  }
  function res(n){
    var ar = gl.drawingBufferWidth / gl.drawingBufferHeight;
    if (ar < 1) ar = 1/ar;
    var min = Math.round(n), max = Math.round(n * ar);
    return gl.drawingBufferWidth > gl.drawingBufferHeight ? { w:max, h:min } : { w:min, h:max };
  }

  function resize(){
    var dpr = Math.min(devicePixelRatio || 1, 1.75);
    var w = Math.floor(canvas.clientWidth * dpr), h = Math.floor(canvas.clientHeight * dpr);
    if (w === 0 || h === 0) return false;
    if (canvas.width !== w || canvas.height !== h){ canvas.width = w; canvas.height = h; return true; }
    return false;
  }
  resize(); initBuffers();

  /* ── dye colour: a narrow band around the logo green, gold now and
     then. Full-spectrum random colour is what makes these effects
     look like a demo instead of a brand. ───────────────────────── */
  function dyeColor(){
    var gold = Math.random() < 0.20;
    var j = 0.72 + Math.random() * 0.56;
    // Absorption values. Green = take out red and blue. Gold = take out blue.
    return gold
      ? { r:0.014*j, g:0.026*j, b:0.082*j }
      : { r:0.062*j, g:0.013*j, b:0.050*j };
  }

  function splat(x, y, dx, dy, color){
    splatP.bind();
    gl.uniform1i(splatP.uniforms.uTarget, velocity.read.attach(0));
    gl.uniform1f(splatP.uniforms.aspectRatio, canvas.width / canvas.height);
    gl.uniform2f(splatP.uniforms.point, x, y);
    gl.uniform3f(splatP.uniforms.color, dx, dy, 0.0);
    gl.uniform1f(splatP.uniforms.radius, CFG.RADIUS / 100.0);
    blit(velocity.write); velocity.swap();

    gl.uniform1i(splatP.uniforms.uTarget, dye.read.attach(0));
    gl.uniform3f(splatP.uniforms.color, color.r, color.g, color.b);
    blit(dye.write); dye.swap();
  }

  /* ── pointer ─────────────────────────────────────────────────── */
  var pointer = { down:false, moved:false, x:0.5, y:0.5, dx:0, dy:0, color:dyeColor() };
  function toLocal(e){
    var r = canvas.getBoundingClientRect();
    return { x:(e.clientX - r.left)/r.width, y:1.0 - (e.clientY - r.top)/r.height };
  }
  function onMove(e){
    var p = toLocal(e);
    pointer.dx = (p.x - pointer.x) * 5.2;
    pointer.dy = (p.y - pointer.y) * 5.2;
    pointer.x = p.x; pointer.y = p.y;
    pointer.moved = Math.abs(pointer.dx) > 0 || Math.abs(pointer.dy) > 0;
  }
  canvas.addEventListener('pointermove', onMove, { passive:true });
  canvas.addEventListener('pointerdown', function(e){
    var p = toLocal(e); pointer.x = p.x; pointer.y = p.y;
    pointer.color = dyeColor();
    splat(p.x, p.y, (Math.random()-0.5)*400, (Math.random()-0.5)*400, pointer.color);
  }, { passive:true });

  /* ── ambient motion: the liquid keeps living without a pointer ── */
  var nextBurst = 0;
  function burst(t){
    if (t < nextBurst) return;
    nextBurst = t + 1400 + Math.random() * 2400;
    var x = 0.18 + Math.random() * 0.64, y = 0.18 + Math.random() * 0.64;
    var a = Math.random() * Math.PI * 2, s = 240 + Math.random() * 380;
    splat(x, y, Math.cos(a)*s, Math.sin(a)*s, dyeColor());
  }

  /* seed so the panel is never empty on first paint */
  for (var k=0;k<6;k++){
    var a0 = (k/6)*Math.PI*2;
    splat(0.5 + Math.cos(a0)*0.2, 0.5 + Math.sin(a0)*0.2, Math.cos(a0)*300, Math.sin(a0)*300, dyeColor());
  }

  /* ── step ────────────────────────────────────────────────────── */
  var last = performance.now(), raf = 0, alive = true, visible = true;
  document.addEventListener('visibilitychange', function(){ visible = !document.hidden; });

  function step(dt){
    gl.disable(gl.BLEND);

    curlP.bind();
    gl.uniform2f(curlP.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
    gl.uniform1i(curlP.uniforms.uVelocity, velocity.read.attach(0));
    blit(curlFBO);

    vortP.bind();
    gl.uniform2f(vortP.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
    gl.uniform1i(vortP.uniforms.uVelocity, velocity.read.attach(0));
    gl.uniform1i(vortP.uniforms.uCurl, curlFBO.attach(1));
    gl.uniform1f(vortP.uniforms.curl, CFG.CURL);
    gl.uniform1f(vortP.uniforms.dt, dt);
    blit(velocity.write); velocity.swap();

    divP.bind();
    gl.uniform2f(divP.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
    gl.uniform1i(divP.uniforms.uVelocity, velocity.read.attach(0));
    blit(divergence);

    clearP.bind();
    gl.uniform1i(clearP.uniforms.uTexture, pressure.read.attach(0));
    gl.uniform1f(clearP.uniforms.value, CFG.PRESSURE);
    blit(pressure.write); pressure.swap();

    pressP.bind();
    gl.uniform2f(pressP.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
    gl.uniform1i(pressP.uniforms.uDivergence, divergence.attach(0));
    for (var i=0;i<CFG.PRESSURE_ITER;i++){
      gl.uniform1i(pressP.uniforms.uPressure, pressure.read.attach(1));
      blit(pressure.write); pressure.swap();
    }

    gradP.bind();
    gl.uniform2f(gradP.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
    gl.uniform1i(gradP.uniforms.uPressure, pressure.read.attach(0));
    gl.uniform1i(gradP.uniforms.uVelocity, velocity.read.attach(1));
    blit(velocity.write); velocity.swap();

    advectP.bind();
    gl.uniform2f(advectP.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
    gl.uniform2f(advectP.uniforms.dyeTexelSize, velocity.texelSizeX, velocity.texelSizeY);
    var vid = velocity.read.attach(0);
    gl.uniform1i(advectP.uniforms.uVelocity, vid);
    gl.uniform1i(advectP.uniforms.uSource, vid);
    gl.uniform1f(advectP.uniforms.dt, dt);
    gl.uniform1f(advectP.uniforms.dissipation, 1.0 - CFG.VELOCITY_DISSIPATION);
    blit(velocity.write); velocity.swap();

    gl.uniform2f(advectP.uniforms.dyeTexelSize, dye.texelSizeX, dye.texelSizeY);
    gl.uniform1i(advectP.uniforms.uVelocity, velocity.read.attach(0));
    gl.uniform1i(advectP.uniforms.uSource, dye.read.attach(1));
    gl.uniform1f(advectP.uniforms.dissipation, 1.0 - CFG.DENSITY_DISSIPATION);
    blit(dye.write); dye.swap();
  }

  function render(now){
    if (!alive) return;
    raf = requestAnimationFrame(render);
    if (!visible) { last = now; return; }

    if (resize()) initBuffers();
    var dt = Math.min((now - last) / 1000, 0.0166);
    last = now;

    if (pointer.moved){
      pointer.moved = false;
      splat(pointer.x, pointer.y, pointer.dx * 900, pointer.dy * 900, pointer.color);
    }
    burst(now);
    step(dt);

    displayP.bind();
    gl.uniform1i(displayP.uniforms.uTexture, dye.read.attach(0));
    blit(null);
  }
  raf = requestAnimationFrame(function(n){ last = n; render(n); });

  return { destroy:function(){ alive = false; cancelAnimationFrame(raf); } };
}

</script>

<script>
/* ══════════════════════════════════════════════════════════════════
   art.js — Ascovita Healthcare

   A second 3D scene, raymarched entirely in a fragment shader. No
   library, no mesh, no model file: the tablet is described as a
   signed-distance field and the image is solved per pixel.

   The subject is the moment a tablet gives way — a pressed disc with
   a punch ring, blended (smooth-union) with droplets that pull away
   from its rim and rise. Same idea as the hero fluid, different
   physics, so the two never look like the same effect twice.

   initArt(canvas) → { destroy() } · null if WebGL is unavailable.
   ══════════════════════════════════════════════════════════════════ */

function initArt(canvas){
  var gl = canvas.getContext('webgl', { alpha:true, antialias:false, premultipliedAlpha:false })
        || canvas.getContext('experimental-webgl', { alpha:true, antialias:false });
  if (!gl) return null;

  var VS = [
    'attribute vec2 p;',
    'void main(){ gl_Position = vec4(p, 0.0, 1.0); }'
  ].join('\n');

  var FS = [
    'precision highp float;',
    'uniform vec2  uRes;',
    'uniform float uTime;',
    'uniform vec2  uPtr;',
    'uniform float uProg;',

    /* ── palette, straight off the logo ─────────────────────────── */
    'const vec3 GREEN = vec3(0.180, 0.490, 0.196);',
    'const vec3 GOLD  = vec3(0.788, 0.635, 0.153);',
    'const vec3 GROUND= vec3(0.910, 0.929, 0.902);',

    /* ── SDF helpers ────────────────────────────────────────────── */
    'float smin(float a, float b, float k){',
    '  float h = clamp(0.5 + 0.5*(b-a)/k, 0.0, 1.0);',
    '  return mix(b, a, h) - k*h*(1.0-h);',
    '}',
    'float sdRoundedCylinder(vec3 p, float ra, float rb, float h){',
    '  vec2 d = vec2(length(p.xz) - 2.0*ra + rb, abs(p.y) - h);',
    '  return min(max(d.x, d.y), 0.0) + length(max(d, 0.0)) - rb;',
    '}',
    'float sdTorus(vec3 p, vec2 t){',
    '  vec2 q = vec2(length(p.xz) - t.x, p.y);',
    '  return length(q) - t.y;',
    '}',
    'mat2 rot(float a){ float c = cos(a), s = sin(a); return mat2(c, -s, s, c); }',
    'float hash(float n){ return fract(sin(n) * 43758.5453123); }',

    /* ── the scene ──────────────────────────────────────────────── */
    'float map(vec3 p){',
    '  vec3 q = p;',
    '  q.xz *= rot(uTime * 0.25);',
    '  q.yz *= rot(0.42 + uPtr.y * 0.28);',
    '  q.xy *= rot(uPtr.x * 0.22);',

    // the tablet: a pressed disc, thinning as it gives way
    '  float body = sdRoundedCylinder(q, 0.40, 0.11, 0.155 - uProg * 0.05);',
    // the punch ring on its face
    '  float ring = sdTorus(q - vec3(0.0, 0.152, 0.0), vec2(0.30, 0.016));',
    '  float d = min(body, ring);',

    // droplets pulling off the rim and rising
    '  for (int i = 0; i < 7; i++){',
    '    float fi = float(i);',
    '    float a  = fi * 0.8976 + uTime * (0.22 + hash(fi) * 0.30);',
    '    float rise = fract(uTime * (0.10 + hash(fi + 9.0) * 0.16) + hash(fi + 3.0));',
    '    float rad  = 0.46 + rise * (0.30 + uProg * 0.40);',
    '    vec3  c = vec3(cos(a) * rad, -0.10 + rise * (0.85 + uProg * 0.5), sin(a) * rad);',
    '    float r = (0.085 + hash(fi + 5.0) * 0.055) * (1.0 - rise * 0.55);',
    '    d = smin(d, length(q - c) - r, 0.16);',
    '  }',
    '  return d;',
    '}',

    'vec3 calcNormal(vec3 p){',
    '  vec2 e = vec2(0.0012, 0.0);',
    '  return normalize(vec3(',
    '    map(p + e.xyy) - map(p - e.xyy),',
    '    map(p + e.yxy) - map(p - e.yxy),',
    '    map(p + e.yyx) - map(p - e.yyx)));',
    '}',

    'float softShadow(vec3 ro, vec3 rd){',
    '  float res = 1.0, t = 0.05;',
    '  for (int i = 0; i < 22; i++){',
    '    float h = map(ro + rd * t);',
    '    res = min(res, 9.0 * h / t);',
    '    t += clamp(h, 0.02, 0.20);',
    '    if (res < 0.005 || t > 3.0) break;',
    '  }',
    '  return clamp(res, 0.0, 1.0);',
    '}',

    'void main(){',
    '  vec2 uv = (gl_FragCoord.xy - 0.5 * uRes) / min(uRes.x, uRes.y);',
    '  vec3 ro = vec3(0.0, 0.0, 2.35);',
    '  vec3 rd = normalize(vec3(uv, -1.55));',

    '  float t = 0.0; float d = 0.0; bool hit = false;',
    '  for (int i = 0; i < 78; i++){',
    '    d = map(ro + rd * t);',
    '    if (d < 0.0016) { hit = true; break; }',
    '    t += d * 0.86;',
    '    if (t > 5.5) break;',
    '  }',

    '  if (!hit) { gl_FragColor = vec4(0.0); return; }',

    '  vec3 pos = ro + rd * t;',
    '  vec3 n   = calcNormal(pos);',
    '  vec3 v   = -rd;',

    // studio lighting: broad key upper-front, cool rim behind, low fill
    '  vec3 kd = normalize(vec3( 0.55, 0.82,  0.62));',
    '  vec3 rl = normalize(vec3(-0.68, 0.24, -0.60));',
    '  vec3 fl = normalize(vec3(-0.30,-0.72,  0.45));',

    '  float key  = max(dot(n, kd), 0.0) * softShadow(pos + n * 0.02, kd);',
    '  float rim  = pow(max(dot(n, rl), 0.0), 1.6);',
    '  float fill = max(dot(n, fl), 0.0) * 0.30;',
    '  float fres = pow(1.0 - max(dot(n, v), 0.0), 3.2);',

    // specular
    '  vec3 h1 = normalize(kd + v);',
    '  float spec = pow(max(dot(n, h1), 0.0), 46.0);',

    // the tablet reads pale; the gold only shows in the rim and the fresnel,
    // so the object stays quiet against the page instead of glowing
    '  vec3 base = mix(vec3(0.965, 0.957, 0.930), GREEN, 0.10 + uProg * 0.08);',
    '  vec3 col  = base * (0.30 + key * 0.72);',
    '  col += GOLD  * rim  * 0.30;',
    '  col += GREEN * fill * 0.35;',
    '  col += vec3(1.0) * spec * 0.55;',
    '  col += GOLD * fres * 0.16;',

    // fade into the page ground with depth so there is no hard cut-out edge
    '  float fog = smoothstep(3.4, 1.3, t);',
    '  col = mix(GROUND, col, fog);',
    '  gl_FragColor = vec4(col, fog);',
    '}'
  ].join('\n');

  function sh(type, src){
    var s = gl.createShader(type);
    gl.shaderSource(s, src); gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) { console.warn(gl.getShaderInfoLog(s)); return null; }
    return s;
  }
  var vs = sh(gl.VERTEX_SHADER, VS), fs = sh(gl.FRAGMENT_SHADER, FS);
  if (!vs || !fs) return null;

  var prog = gl.createProgram();
  gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog);
  if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return null;
  gl.useProgram(prog);

  var buf = gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER, buf);
  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 3,-1, -1,3]), gl.STATIC_DRAW);
  var loc = gl.getAttribLocation(prog, 'p');
  gl.enableVertexAttribArray(loc);
  gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

  var uRes  = gl.getUniformLocation(prog, 'uRes'),
      uTime = gl.getUniformLocation(prog, 'uTime'),
      uPtr  = gl.getUniformLocation(prog, 'uPtr'),
      uProg = gl.getUniformLocation(prog, 'uProg');

  gl.enable(gl.BLEND);
  gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

  function resize(){
    // raymarching costs per pixel, so cap the buffer hard — this scene
    // looks identical at 1.25x and costs 40% less than at 2x
    var dpr = Math.min(window.devicePixelRatio || 1, 1.25);
    var w = Math.max(1, Math.floor(canvas.clientWidth  * dpr));
    var h = Math.max(1, Math.floor(canvas.clientHeight * dpr));
    if (canvas.width !== w || canvas.height !== h){
      canvas.width = w; canvas.height = h;
      gl.viewport(0, 0, w, h);
    }
  }
  resize();
  window.addEventListener('resize', resize);

  var px = 0, py = 0, tx = 0, ty = 0;
  window.addEventListener('pointermove', function(e){
    var r = canvas.getBoundingClientRect();
    tx = (e.clientX - r.left) / r.width  - 0.5;
    ty = (e.clientY - r.top)  / r.height - 0.5;
  }, { passive:true });

  var prog01 = 0, targetProg = 0;
  function readScroll(){
    var r = canvas.getBoundingClientRect();
    var seen = 1 - (r.top + r.height * 0.5) / window.innerHeight;
    targetProg = Math.min(1, Math.max(0, seen));
  }
  window.addEventListener('scroll', readScroll, { passive:true });
  readScroll();

  var alive = true, visible = true, raf = 0, t0 = performance.now();
  document.addEventListener('visibilitychange', function(){ visible = !document.hidden; });

  function frame(now){
    if (!alive) return;
    raf = requestAnimationFrame(frame);
    if (!visible) return;
    resize();
    px += (tx - px) * 0.055;
    py += (ty - py) * 0.055;
    prog01 += (targetProg - prog01) * 0.06;

    gl.uniform2f(uRes, canvas.width, canvas.height);
    gl.uniform1f(uTime, (now - t0) / 1000);
    gl.uniform2f(uPtr, px, py);
    gl.uniform1f(uProg, prog01);
    gl.drawArrays(gl.TRIANGLES, 0, 3);
  }
  raf = requestAnimationFrame(frame);

  return { destroy:function(){ alive = false; cancelAnimationFrame(raf); } };
}

</script>

<script>
/* ══════════════════════════════════════════════════════════════════
   site.js — Ascovita Healthcare
   Nav, scroll reveals, logo fallback, and booting the fluid hero.
   ══════════════════════════════════════════════════════════════════ */
(function(){
  'use strict';

  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── mobile nav ────────────────────────────────────────────────── */
  var toggle = document.querySelector('.nav-toggle');
  var links  = document.querySelector('.nav-links');
  if (toggle && links) {
    toggle.addEventListener('click', function(){
      var open = links.classList.toggle('open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', function(e){
      if (!links.contains(e.target) && !toggle.contains(e.target)) {
        links.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }

  /* ── mark the current page in the nav ──────────────────────────── */
  var here = location.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
  if (here === '') here = '/';
  document.querySelectorAll('.nav-links a').forEach(function(a){
    var href = a.getAttribute('href') || '';
    var path = href.replace(/^\.\//, '/').replace(/\.html$/, '');
    if (path === '/index') path = '/';
    if (path === here || (here === '/' && (href === 'index.html' || href === '/'))) {
      a.setAttribute('aria-current', 'page');
    }
  });

  /* ── scroll reveal (re-callable: the SPA router invokes it per route) ── */
  window.__ascovitaReveal = function(scope){
    var nodes = (scope || document).querySelectorAll('.rv');
    if (!('IntersectionObserver' in window) || reduced) {
      nodes.forEach(function(el){ el.classList.add('in'); });
      return;
    }
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if (en.isIntersecting) { en.target.classList.add('in'); obs.unobserve(en.target); }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
    nodes.forEach(function(el){ obs.observe(el); });
  };

  /* ── original one-shot reveal ─────────────────────────────────── */
  var rv = document.querySelectorAll('.rv');
  if (!('IntersectionObserver' in window) || reduced) {
    rv.forEach(function(el){ el.classList.add('in'); });
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
    rv.forEach(function(el){ io.observe(el); });
  }

  /* ── logo: if the hosted file ever moves, fall back to a wordmark
        rather than showing a broken image on every page ─────────── */
  document.querySelectorAll('.brand img, .disc img').forEach(function(img){
    img.addEventListener('error', function(){
      var host = img.parentNode;
      img.remove();
      if (host.classList.contains('disc')) { host.remove(); return; }
      var span = document.createElement('span');
      span.className = 'fallback';
      span.textContent = 'Ascovita';
      host.insertBefore(span, host.firstChild);
    });
  });

  /* ── year ──────────────────────────────────────────────────────── */
  document.querySelectorAll('[data-year]').forEach(function(el){
    el.textContent = new Date().getFullYear();
  });

  /* ── fluid hero (router calls this again when Home is shown) ───── */
  var started = false;
  var shell  = document.querySelector('.fluid-shell');
  var canvas = shell && shell.querySelector('canvas');

  function fallback(){
    if (!shell) return;
    shell.classList.add('fallback');
    if (canvas) canvas.style.display = 'none';
    var note = shell.querySelector('.note');
    if (note) note.remove();
  }

  if (!shell || !canvas) return;

  // Honour reduced-motion: a continuously churning fluid is exactly the
  // kind of thing that setting exists for.
  if (reduced || typeof initFluid !== 'function') { fallback(); return; }

  // Only start once the panel is actually on screen — no point running a
  // pressure solve for a canvas nobody has scrolled to yet.
  function boot(){
    if (started) return;
    started = true;
    var instance = null;
    try { instance = initFluid(canvas); } catch (e) { instance = null; }
    if (!instance) { fallback(); return; }
    window.addEventListener('pagehide', function(){ instance.destroy(); });
  }

  window.__ascovitaFluid = function(){
    if (started) return;
    if (shell.offsetParent === null) return;  // Home not on screen yet
    boot();
  };

  if ('IntersectionObserver' in window) {
    var io2 = new IntersectionObserver(function(entries){
      if (entries[0].isIntersecting) { io2.disconnect(); boot(); }
    }, { rootMargin: '200px' });
    io2.observe(shell);
  } else {
    boot();
  }

  /* ── raymarched art panels ─────────────────────────────────────
     Same lazy pattern as the fluid: a per-pixel raymarch has no
     business running for a canvas the reader has not reached. */
  window.__ascovitaArt = function(scope){
    if (reduced || typeof initArt !== 'function') {
      (scope || document).querySelectorAll('.art-shell').forEach(function(sh){
        sh.classList.add('fallback');
        var c = sh.querySelector('canvas'); if (c) c.style.display = 'none';
        var cap = sh.querySelector('.art-cap'); if (cap) cap.remove();
      });
      return;
    }
    (scope || document).querySelectorAll('canvas.art-canvas').forEach(function(cv){
      if (cv.__art) return;
      var host = cv.closest('.art-shell');
      var start = function(){
        if (cv.__art) return;
        cv.__art = true;
        var inst = null;
        try { inst = initArt(cv); } catch (e) { inst = null; }
        if (!inst && host) {
          host.classList.add('fallback');
          cv.style.display = 'none';
          var cap = host.querySelector('.art-cap'); if (cap) cap.remove();
        }
      };
      window.__ascovitaFluid = function(){
    if (started) return;
    if (shell.offsetParent === null) return;  // Home not on screen yet
    boot();
  };

  if ('IntersectionObserver' in window) {
        var io3 = new IntersectionObserver(function(en){
          if (en[0].isIntersecting) { io3.disconnect(); start(); }
        }, { rootMargin: '250px' });
        io3.observe(cv);
      } else { start(); }
    });
  };
  window.__ascovitaArt(document);
})();

</script>

<script>
/* ══════════════════════════════════════════════════════════════════
   motion.js — Ascovita Healthcare

   Small, restrained motion. Everything here checks
   prefers-reduced-motion first and everything is passive-listener
   and rAF-batched, because a marketing page has no business
   dropping frames on a mid-range Android.
   ══════════════════════════════════════════════════════════════════ */
(function(){
  'use strict';
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var coarse  = window.matchMedia('(pointer: coarse)').matches;

  /* ── 1. 3D tilt on cards ───────────────────────────────────────
     Pointer-driven perspective rotation. Skipped entirely on touch:
     on a phone there is no hover, so a tilt would either never fire
     or fire on tap and feel broken. */
  function initTilt(scope){
    if (reduced || coarse) return;
    (scope || document).querySelectorAll('[data-tilt]').forEach(function(el){
      if (el.__tilt) return;
      el.__tilt = true;
      var raf = null, rx = 0, ry = 0;

      el.addEventListener('pointermove', function(e){
        var r = el.getBoundingClientRect();
        var cx = (e.clientX - r.left) / r.width  - 0.5;
        var cy = (e.clientY - r.top)  / r.height - 0.5;
        ry =  cx * 7;
        rx = -cy * 7;
        if (!raf) raf = requestAnimationFrame(apply);
      }, { passive:true });

      el.addEventListener('pointerleave', function(){
        rx = 0; ry = 0;
        if (!raf) raf = requestAnimationFrame(apply);
      }, { passive:true });

      function apply(){
        raf = null;
        el.style.transform = 'perspective(900px) rotateX(' + rx.toFixed(2) +
                             'deg) rotateY(' + ry.toFixed(2) + 'deg)';
      }
    });
  }

  /* ── 2. Counters ───────────────────────────────────────────────
     Counts to the value in data-count when the element first
     appears. Keeps the suffix (k+, %, ★) intact. */
  function initCounters(scope){
    var nodes = (scope || document).querySelectorAll('[data-count]');
    if (!nodes.length) return;

    function run(el){
      if (el.__counted) return;
      el.__counted = true;
      var to      = parseFloat(el.getAttribute('data-count'));
      var dec     = (el.getAttribute('data-dec') | 0);
      var suffix  = el.getAttribute('data-suffix') || '';
      if (reduced) { el.textContent = to.toFixed(dec) + suffix; return; }
      var start = null, dur = 1400;
      function tick(now){
        if (start === null) start = now;
        var k = Math.min(1, (now - start) / dur);
        var e = 1 - Math.pow(1 - k, 3);              // ease-out cubic
        el.textContent = (to * e).toFixed(dec) + suffix;
        if (k < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    if (!('IntersectionObserver' in window)) { nodes.forEach(run); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if (en.isIntersecting) { run(en.target); io.unobserve(en.target); }
      });
    }, { threshold:0.4 });
    nodes.forEach(function(n){ io.observe(n); });
  }

  /* ── 3. Scroll parallax ────────────────────────────────────────
     One rAF loop for every parallax element on the page, rather than
     one listener each. data-parallax is the strength in pixels. */
  var parallaxEls = [];
  function initParallax(scope){
    if (reduced) return;
    (scope || document).querySelectorAll('[data-parallax]').forEach(function(el){
      if (parallaxEls.indexOf(el) === -1) parallaxEls.push(el);
    });
  }
  var ticking = false;
  function onScroll(){
    if (reduced || ticking || !parallaxEls.length) return;
    ticking = true;
    requestAnimationFrame(function(){
      ticking = false;
      var vh = window.innerHeight;
      for (var i = 0; i < parallaxEls.length; i++){
        var el = parallaxEls[i];
        if (el.offsetParent === null) continue;
        var r = el.getBoundingClientRect();
        if (r.bottom < -200 || r.top > vh + 200) continue;
        var mid = (r.top + r.height / 2 - vh / 2) / vh;   // -0.5 … 0.5
        var k = parseFloat(el.getAttribute('data-parallax')) || 20;
        el.style.transform = 'translate3d(0,' + (mid * -k).toFixed(1) + 'px,0)';
      }
    });
  }
  window.addEventListener('scroll', onScroll, { passive:true });
  window.addEventListener('resize', onScroll, { passive:true });

  /* ── 4. Marquee ────────────────────────────────────────────────
     Duplicates its own children once so the loop is seamless, then
     animates on the GPU. Pauses on hover so a reader can stop it. */
  function initMarquee(scope){
    (scope || document).querySelectorAll('[data-marquee]').forEach(function(el){
      if (el.__marquee) return;
      el.__marquee = true;
      var track = el.querySelector('.mq-track');
      if (!track) return;
      track.innerHTML += track.innerHTML;
      if (reduced) { el.classList.add('mq-static'); return; }
      var speed = parseFloat(el.getAttribute('data-marquee')) || 42;
      track.style.animationDuration = speed + 's';
      el.classList.add('mq-run');
    });
  }

  /* ── 5. Magnetic buttons ───────────────────────────────────────
     A couple of pixels of pull toward the cursor. Enough to feel
     responsive, small enough that nobody consciously notices. */
  function initMagnetic(scope){
    if (reduced || coarse) return;
    (scope || document).querySelectorAll('[data-magnetic]').forEach(function(el){
      if (el.__mag) return;
      el.__mag = true;
      el.addEventListener('pointermove', function(e){
        var r = el.getBoundingClientRect();
        var x = (e.clientX - r.left - r.width  / 2) * 0.22;
        var y = (e.clientY - r.top  - r.height / 2) * 0.30;
        el.style.transform = 'translate(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px)';
      }, { passive:true });
      el.addEventListener('pointerleave', function(){ el.style.transform = ''; }, { passive:true });
    });
  }

  /* ── 6. Scroll progress rail ───────────────────────────────────── */
  var bar = document.getElementById('progress');
  if (bar && !reduced) {
    window.addEventListener('scroll', function(){
      var max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.transform = 'scaleX(' + (max > 0 ? window.scrollY / max : 0) + ')';
    }, { passive:true });
  }

  /* ── expose so the SPA router can re-run these per route ──────── */
  window.__ascovitaMotion = function(scope){
    initTilt(scope); initCounters(scope); initParallax(scope);
    initMarquee(scope); initMagnetic(scope); onScroll();
  };
  window.__ascovitaMotion(document);
})();

</script>

<script>

/* ══════════════════════════════════════════════════════════════════
   Router — hash based, because this is a single file on static
   hosting. Every page's markup is already in the document; the
   router only decides which one is visible. That means all the copy
   is in the HTML source for crawlers even though only one section
   is on screen at a time.
   ══════════════════════════════════════════════════════════════════ */
(function(){
  'use strict';
  var pages = Array.prototype.slice.call(document.querySelectorAll('.page'));
  var links = Array.prototype.slice.call(document.querySelectorAll('[data-route]'));
  var metaDesc = document.querySelector('meta[name="description"]');
  var canonical = document.querySelector('link[rel="canonical"]');
  var current = null;

  function parse(){
    var h = (location.hash || '#/').replace(/^#/, '');
    if (h.indexOf('//') === 0) return { route:'/', frag:h.slice(2) };  // #//anchor on home
    var parts = h.split('/').filter(Boolean);
    if (!parts.length) return { route:'/', frag:'' };
    return { route:'/' + parts[0], frag: parts[1] || '' };
  }

  function show(){
    var r = parse();
    var target = null;
    for (var i=0;i<pages.length;i++){
      if (pages[i].getAttribute('data-route') === r.route) { target = pages[i]; break; }
    }
    if (!target) target = document.getElementById('pg-404');

    if (target !== current) {
      pages.forEach(function(p){
        if (p === target) { p.hidden = false; p.classList.add('active'); }
        else { p.hidden = true; p.classList.remove('active'); }
      });
      current = target;

      document.title = target.getAttribute('data-title') || document.title;
      if (metaDesc) metaDesc.setAttribute('content', target.getAttribute('data-desc') || '');
      if (canonical) canonical.setAttribute('href', 'https://www.ascovita.com/' + (location.hash || ''));

      links.forEach(function(a){
        var isHere = a.getAttribute('data-route') === '#' + r.route ||
                     (r.route === '/' && a.getAttribute('data-route') === '#/');
        if (isHere) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });

      // re-run reveals for whatever just became visible
      window.__ascovitaReveal && window.__ascovitaReveal(target);
      window.__ascovitaMotion && window.__ascovitaMotion(target);
      // boot the heavy canvases only once the page holding them is visible
      window.__ascovitaFluid && window.__ascovitaFluid();
      window.__ascovitaArt   && window.__ascovitaArt(target);
    }

    var menu = document.querySelector('.nav-links');
    if (menu) menu.classList.remove('open');

    if (r.frag) {
      var el = document.getElementById(r.frag);
      if (el) { el.scrollIntoView({ behavior:'smooth', block:'start' }); return; }
    }
    window.scrollTo(0, 0);
  }

  window.addEventListener('hashchange', show);
  show();
})();

</script>
</body>
</html>
